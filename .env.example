# Copia questo file in .env e completa i valori (facoltativi).

# Indirizzo base del backend dei consensi cookie (il sito chiama /consent/config e /consent;
# deve accettare richieste CORS dal dominio del sito). Vuoto = scelte applicate ma non registrate.
VITE_CONSENT_API_URL=

# Versione della Cookie Policy usata finché non arriva quella del backend (/consent/config).
VITE_COOKIE_POLICY_VERSION=1.0.0

# Indirizzo della Cookie Policy mostrato nel banner. Vuoto = link non mostrato.
VITE_COOKIE_POLICY_URL=
